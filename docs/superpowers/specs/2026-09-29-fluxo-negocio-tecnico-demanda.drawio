  <diagram name="Fluxo negocio-tecnico">
    <mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1860" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Fluxo de refinamento: negocio -&gt; tecnico, com a Demanda como fonte de verdade compartilhada" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1820" height="40" as="geometry" />
        </mxCell>

        <!-- Lane backgrounds -->
        <mxCell id="laneNeg" value="Negocio / Analista de Requisitos" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontStyle=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="20" y="80" width="430" height="500" as="geometry" />
        </mxCell>
        <mxCell id="laneTec" value="Tecnica (refinamento-planejamento-tecnico)" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=center;fontStyle=1;fontSize=14;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1390" y="80" width="430" height="500" as="geometry" />
        </mxCell>

        <!-- Negocio lane skills -->
        <mxCell id="n1" value="redigir-spec-demanda-azure-boards&#xa;[ALTERADA] Le a Demanda (GET), investiga codigo,&#xa;escreve spec.md/negocio.md local.&#xa;Ao terminar: ANEXA spec.md a Demanda." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="50" y="120" width="370" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="entrevistar-lacunas-requisito&#xa;[ALTERADA] Fecha lacunas por rodada (negocio ou tecnica),&#xa;grava decisoes em spec.md.&#xa;Ao fim de cada rodada: regenera negocio.md e&#xa;SINCRONIZA a Demanda (reanexa spec.md)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="50" y="240" width="370" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="gerar-backlog-azure-boards&#xa;A partir de spec.md, gera backlog.md&#xa;(Epicos / Features / Historias / Bugs)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="50" y="380" width="370" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="publicar-backlog-demanda-azure-boards&#xa;Publica backlog.md como work items reais,&#xa;filhos da Demanda." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="50" y="470" width="370" height="70" as="geometry" />
        </mxCell>

        <!-- Tecnica lane skills -->
        <mxCell id="t1" value="refinar-tecnicamente&#xa;[ALTERADA] Resolve spec.md pelo ID: pasta local OU&#xa;anexo da Demanda (fallback novo).&#xa;Fecha lacunas Tecnico, sugere Story Points.&#xa;Ao gravar: grava campo tecnico e REANEXA spec.md/backlog.md." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1420" y="120" width="370" height="110" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="decompor-tasks&#xa;Le o campo tecnico direto da Demanda,&#xa;decompoe em Tasks estimadas em horas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1420" y="270" width="370" height="70" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="preparar-implementacao&#xa;Le campos tecnico + negocio + Tasks direto da&#xa;Demanda, monta o briefing para o desenvolvedor." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=6;" vertex="1" parent="1">
          <mxGeometry x="1420" y="380" width="370" height="70" as="geometry" />
